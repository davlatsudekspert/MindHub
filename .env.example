# PostgreSQL ulanish satri
DATABASE_URL=postgres://user:password@localhost:5432/mindhub

# Token imzolash uchun maxfiy kalit — majburiy, default qiymat yo'q.
# Generatsiya: openssl rand -hex 32
SECRET=

# HTTP server porti
PORT=3000

# Yuklangan fayllar saqlanadigan papka
DATA_DIR=./data

# Ilova joylashgan ochiq manzil (emaillar va havolalar uchun)
APP_URL=http://localhost:3000

# Resend orqali email yuborish uchun API kalit (https://resend.com)
RESEND_API_KEY=

# Email "Kimdan" manzili
MAIL_FROM=MindHub <no-reply@mindhub.uz>

# Gmail SMTP fallback (Resend bo'lmasa ishlatiladi) — Google App Password
SMTP_USER=
SMTP_PASS=

# Telegram bot tokeni — @BotFather orqali oling
TELEGRAM_BOT_TOKEN=

# CORS: frontend joylashgan originlar, vergul bilan ajratilgan.
# Bo'sh bo'lsa, boshqa originlardan browserda API'ga so'rov yuborilmaydi.
# Masalan: ALLOWED_ORIGINS=https://mindhub.uz,https://www.mindhub.uz
ALLOWED_ORIGINS=

# AI Fikr Taqsimlovchi (FAZA 3) — ixtiyoriy. Bo'sh bo'lsa, klasterlash butunlay
# o'chadi, ilova baribir to'liq ishlaydi.
# AI_PROVIDER: 'cloudflare' | 'openai' | 'anthropic' (anthropic faqat chat/xulosa uchun,
# embedding'ga cloudflare yoki openai kerak)
AI_PROVIDER=cloudflare
AI_API_KEY=
# Faqat AI_PROVIDER=cloudflare uchun — Cloudflare akkaunt ID (dashboard.cloudflare.com)
CF_ACCOUNT_ID=
# Ixtiyoriy: model nomlarini o'zgartirish (bo'sh qoldirsa standart modellar ishlatiladi)
AI_EMBED_MODEL=
AI_CHAT_MODEL=
# Klasterlash sozlamalari (ixtiyoriy, standart qiymatlar yetarli)
CLUSTER_THRESHOLD=0.78
CLUSTER_MIN_SIZE=3

# Fayl saqlash (FAZA 6): 'local' (standart, Railway diskiga — efemer, deploy'dan
# keyin fayllar yo'qoladi) yoki 'r2' (Cloudflare R2). r2 tanlansa, quyidagilar majburiy:
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 bucket ulangan ochiq domen (oxirida / bo'lmasin), masalan: https://cdn.mindhub.uz
R2_PUBLIC_URL=
